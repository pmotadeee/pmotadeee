<script>
	const colors = {
		default: "var(--wc-mode-default)",
		plan: "var(--wc-mode-plan)",
		build: "var(--wc-mode-build)",
	};

	const shell = document.getElementById("shell");
	const tabs = Array.from(document.querySelectorAll(".mode"));

	tabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			tabs.forEach((t) =>
				t.setAttribute("aria-selected", String(t === tab)),
			);
			shell.style.setProperty(
				"--composer-border-color",
				colors[tab.dataset.mode],
			);
		});
	});

	// TTS flame waveform
	(function () {
		const height = 96;
		const wrap = document.getElementById("ttsWrap");
		const canvas = document.getElementById("ttsCanvas");
		const ctx = canvas.getContext("2d");
		const dpr = window.devicePixelRatio || 1;
		let width = wrap.clientWidth;

		const resize = () => {
			width = wrap.clientWidth;
			canvas.width = width * dpr;
			canvas.height = height * dpr;
			canvas.style.width = width + "px";
			canvas.style.height = height + "px";
			ctx.setTransform(1, 0, 0, 1, 0, 0);
			ctx.scale(dpr, dpr);
		};

		resize();
		new ResizeObserver(resize).observe(wrap);

		const bufferLength = 1024;
		const data = new Uint8Array(bufferLength);
		const samples = 64;
		const binStart = 2;
		const binEnd = Math.floor(bufferLength * 0.6);
		const usableBins = binEnd - binStart;
		let phase = 0;

		const formants = [
			{ base: 0.08, range: 0.02, speed: 0.71, width: 0.03, gain: 1.0 },
			{ base: 0.18, range: 0.035, speed: 0.47, width: 0.04, gain: 0.85 },
			{ base: 0.3, range: 0.05, speed: 0.33, width: 0.055, gain: 0.62 },
			{ base: 0.44, range: 0.06, speed: 0.24, width: 0.075, gain: 0.4 },
		];

		const fillSpectrum = (t) => {
			const s =
				Math.sin(t * 4.7) * 0.5 +
				Math.sin(t * 2.9 + 1.1) * 0.3 +
				Math.sin(t * 1.7 + 2.3) * 0.2;
			let env = Math.max(0, s * 0.5 + 0.5);
			env = Math.pow(env, 1.5);
			const breath = 0.5 + 0.5 * Math.sin(t * 0.37);
			env *= 0.3 + 0.7 * Math.pow(breath, 0.8);

			for (let i = 0; i < bufferLength; i++) {
				const f = i / bufferLength;
				let v = 0.1 * Math.exp(-Math.pow(f / 0.28, 2));
				for (let k = 0; k < formants.length; k++) {
					const fm = formants[k];
					const c =
						fm.base +
						fm.range * Math.sin(t * fm.speed * 2 + k * 1.9);
					const d = (f - c) / fm.width;
					v += fm.gain * Math.exp(-d * d);
				}
				v *= env * (0.8 + 0.2 * Math.sin(t * 15 + i * 0.31));
				v += 0.03 * Math.random() * env;
				data[i] = Math.max(0, Math.min(255, Math.round(v * 255)));
			}
		};

		const drawPass = (pts, hueShift, alpha, yScale) => {
			ctx.beginPath();
			ctx.moveTo(0, height);
			ctx.lineTo(pts[0].x, height - pts[0].y * yScale);
			for (let i = 0; i < pts.length - 1; i++) {
				const p0 = pts[i];
				const p1 = pts[i + 1];
				const mx = (p0.x + p1.x) / 2;
				const my = height - ((p0.y + p1.y) / 2) * yScale;
				ctx.quadraticCurveTo(p0.x, height - p0.y * yScale, mx, my);
			}
			ctx.lineTo(width, height);
			ctx.closePath();
			const grad = ctx.createLinearGradient(0, height, width, 0);
			grad.addColorStop(
				0,
				`hsla(${(190 + hueShift) % 360}, 90%, 65%, ${alpha})`,
			);
			grad.addColorStop(
				0.33,
				`hsla(${(270 + hueShift) % 360}, 85%, 65%, ${alpha})`,
			);
			grad.addColorStop(
				0.66,
				`hsla(${(320 + hueShift) % 360}, 90%, 65%, ${alpha})`,
			);
			grad.addColorStop(
				1,
				`hsla(${(20 + hueShift) % 360}, 95%, 65%, ${alpha})`,
			);
			ctx.fillStyle = grad;
			ctx.fill();
		};

		const draw = () => {
			fillSpectrum(performance.now() / 1000);
			ctx.clearRect(0, 0, width, height);
			phase = (phase + 0.4) % 360;

			const pts = [];
			const cx = samples / 2;
			for (let i = 0; i <= samples; i++) {
				const binIndex =
					binStart + Math.floor((i / samples) * usableBins);
				const v = data[binIndex] / 255;
				const envelope = 1 - Math.pow(Math.abs(i - cx) / cx, 1.6);
				const amp = v * envelope;
				const y = Math.max(2, amp * height * 0.95);
				const x = (i / samples) * width;
				pts.push({ x: x, y: y });
			}

			ctx.globalCompositeOperation = "lighter";
			ctx.filter = "blur(14px)";
			drawPass(pts, phase, 0.35, 1.15);
			ctx.filter = "blur(7px)";
			drawPass(pts, phase + 60, 0.3, 1.0);
			ctx.filter = "blur(2px)";
			drawPass(pts, phase + 120, 0.25, 0.85);
			ctx.filter = "none";
			ctx.globalCompositeOperation = "source-over";

			requestAnimationFrame(draw);
		};

		draw();
	})();
</script>
