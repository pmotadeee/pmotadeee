</style>

<script>
	const colors = {
		default: "var(--wc-mode-default)",
		plan: "var(--wc-mode-plan)",
		build: "var(--wc-mode-build)",
	};

	const shell = document.getElementById("subagents-shell");
	const tabs = Array.from(shell?.querySelectorAll(".mode") ?? []);

	tabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			tabs.forEach((t) => t.setAttribute("aria-selected", String(t === tab)));
			shell.style.setProperty("--composer-border-color", colors[tab.dataset.mode]);
		});
	});
</script>
