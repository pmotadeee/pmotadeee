	.split .main {
		width: 30px;
	}
	.split .caret-btn {
		width: 20px;
		color: var(--wc-text-faint);
		border-left: 1px solid var(--wc-border-subtle);
	}
	.split button:hover {
		background: var(--wc-bg-hover);
	}
	.split svg {
		width: 14px;
		height: 14px;
	}
	.split .caret-btn svg {
		width: 11px;
		height: 11px;
	}

	.editor {
		min-height: 62px;
		padding: 6px 8px;
		font-size: 14px;
		line-height: 1.5;
		outline: none;
	}

	.editor:empty::before {
		content: attr(data-placeholder);
		color: var(--wc-text-placeholder);
	}

	.dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
