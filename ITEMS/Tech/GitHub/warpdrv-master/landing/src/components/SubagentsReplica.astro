		border-color: var(--wc-border-default);
	}
	.pill svg {
		width: 15px;
		height: 15px;
	}
	.pill .caret {
		width: 12px;
		height: 12px;
	}

	.pill.green {
		border-color: var(--wc-accent-green-border);
		background: var(--wc-accent-green-bg-8);
		color: var(--wc-accent-green);
	}
	.pill.blue {
		border-color: var(--wc-accent-blue-border);
		background: var(--wc-accent-blue-bg-8);
		color: var(--wc-accent-blue);
	}

	.pill.model {
		border-color: color-mix(in srgb, var(--composer-border-color) 45%, transparent);
		background: color-mix(in srgb, var(--composer-border-color) 12%, transparent);
		color: var(--wc-text-secondary);
	}

	.icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border: 1px solid var(--wc-border-subtle);
		border-radius: 9px;
		background: transparent;
		color: var(--wc-text-tertiary);
		cursor: pointer;
	}

	.icon-btn:hover {
		background: var(--wc-bg-hover);
		color: var(--wc-text-secondary);
	}
	.icon-btn svg {
		width: 15px;
		height: 15px;
	}
	.icon-btn.send {
		border-color: var(--wc-accent-blue-border);
		background: var(--wc-accent-blue-bg-8);
		color: var(--wc-accent-blue);
	}

	.split {
		display: inline-flex;
		align-items: center;
		height: 34px;
		border: 1px solid var(--wc-border-subtle);
