	.context {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 0 4px 2px;
	}
	.track {
		position: relative;
		flex: 1;
		height: 3px;
		border-radius: 2px;
		background: var(--wc-border-subtle);
		overflow: hidden;
	}
	.fill {
		position: absolute;
		inset: 0 auto 0 0;
		width: 0.05%;
		border-radius: 2px;
		background: var(--wc-text-muted);
	}
	.context span {
		font-size: 11.5px;
		color: var(--wc-text-muted);
		font-variant-numeric: tabular-nums;
