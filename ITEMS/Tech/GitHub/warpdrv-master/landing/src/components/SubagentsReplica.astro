	/* ---------- composer ---------- */

	.composer-root {
		position: relative;
		display: flex;
		width: 100%;
		flex-direction: column;
	}

	.composer-shell {
		display: flex;
		width: 100%;
		flex-direction: column;
		gap: 10px;
		border-radius: 12px;
		padding: var(--composer-padding);
		background: var(--wc-bg-elevated);
		box-shadow: 0px 10px 10px 10px rgba(0, 0, 0, 0.15);
		color: var(--wc-text-primary);
	}

	.composer-gradient-border {
		position: relative;
		border: none;
	}

	.composer-gradient-border::before {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		padding: 2px;
		background: radial-gradient(
			ellipse 80% 150% at 50% 0%,
			var(--composer-border-color) 0%,
			transparent 75%
		);
		opacity: 1;
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		mask-composite: exclude;
		pointer-events: none;
		transition: background 200ms ease;
	}

	.row {
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.grow {
		flex: 1;
	}

	.modes {
		display: flex;
		align-items: center;
		gap: 2px;
	}

	.mode {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 32px;
		padding: 0 11px;
		border: none;
		border-radius: 7px;
		background: transparent;
		color: var(--wc-text-tertiary);
		font-size: 13px;
		font-family: inherit;
		cursor: pointer;
		transition:
			background 140ms ease,
			color 140ms ease;
	}

	.mode:hover {
		background: var(--wc-bg-hover);
		color: var(--wc-text-secondary);
	}
	.mode[aria-selected="true"] {
		background: color-mix(in srgb, var(--mode-color) 16%, transparent);
		color: var(--mode-color);
	}
	.mode[data-mode="default"] {
		--mode-color: var(--wc-text-primary);
	}
	.mode[data-mode="plan"] {
		--mode-color: var(--wc-mode-plan);
	}
	.mode[data-mode="build"] {
		--mode-color: var(--wc-mode-build);
	}
	.mode svg {
		width: 13px;
		height: 13px;
	}

	.pill {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		height: 34px;
		padding: 0 12px;
		border: 1px solid var(--wc-border-subtle);
		border-radius: 9px;
		background: transparent;
		color: var(--wc-text-tertiary);
		font-size: 12.5px;
		font-family: inherit;
		cursor: pointer;
		white-space: nowrap;
	}

	.pill:hover {
