   double bbU = GetIndicator(h_bb, 1);
   double bbM = GetIndicator(h_bb, 0);
   double bbL = GetIndicator(h_bb, 2);
   double emaF = GetIndicator(h_ema_fast);
   double emaS = GetIndicator(h_ema_slow);
   double macd_main = GetIndicator(h_macd, 0);
   double macd_signal = GetIndicator(h_macd, 1);
   double stoch_main = GetIndicator(h_stoch, 0);
   double stoch_signal = GetIndicator(h_stoch, 1);
   
   // F0: RSI (normalizado)
   f.Set(0, (rsi - 50.0) / 50.0);
   
   // F1: ADX
   f.Set(1, adx / 100.0);
   
   // F2: Trend (log ratio + tanh)
   if(emaS > EPSILON) {
      double log_ratio = MathLog(emaF / emaS);
      f.Set(2, MathTanh(log_ratio * 100.0));
   }
   
   // F3: ATR relativo
   f.Set(3, (price > EPSILON) ? atr / price : 0.0);
   
   // F4: Bollinger position
   double bb_range = bbU - bbL;
   if(bb_range > EPSILON)
      f.Set(4, (price - bbL) / bb_range);
   
   // F5: Spread relativo
   double spread = SymbolInfoInteger(_Symbol, SYMBOL_SPREAD) * SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   f.Set(5, (price > EPSILON) ? spread / price : 0.0);
   
   // F6: MACD divergence
   f.Set(6, macd_main - macd_signal);
   
   // F7: Stochastic position
   f.Set(7, stoch_main / 100.0);
   
   // F8: Stochastic divergence
   f.Set(8, (stoch_main - stoch_signal) / 100.0);
   
   // F9: Momentum (14-period ROC)
   double price_14 = iClose(_Symbol, PERIOD_M5, 14);
   if(price_14 > EPSILON)
      f.Set(9, MathTanh((price - price_14) / price_14 * 100.0));
   
   // F10: Volume surge
   double vol_current = (double)iVolume(_Symbol, PERIOD_M5, 0);
   double vol_avg = 0;
   for(int i=1; i<=20; i++)
      vol_avg += (double)iVolume(_Symbol, PERIOD_M5, i);
   vol_avg /= 20.0;
   
   if(vol_avg > 1.0)
      f.Set(10, MathTanh(MathLog(vol_current / vol_avg)));
   
   // F11: Price to BB middle distance
   if(atr > EPSILON)
      f.Set(11, (price - bbM) / atr);
   
   return f;
}

