cpp
class CMultiLayerPerceptron {
private:
   static const int HIDDEN1 = 12;
   static const int HIDDEN2 = 6;
   
   double W1[MAX_FEATURES][HIDDEN1];
   double b1[HIDDEN1];
   double W2[HIDDEN1][HIDDEN2];
   double b2[HIDDEN2];
   double W3[HIDDEN2];
   double b3;
   
   // Batch Normalization params
   double bn_mean[HIDDEN1], bn_var[HIDDEN1];
   double bn_gamma[HIDDEN1], bn_beta[HIDDEN1];
   
   double LeakyReLU(double x, double alpha = 0.01) {
      return (x > 0) ? x : alpha * x;
   }
   
   double LeakyReLU_Derivative(double x, double alpha = 0.01) {
      return (x > 0) ? 1.0 : alpha;
   }
   
   void BatchNorm(double &h[], int size) {
      // Running average durante inferência
      for(int i=0; i<size; i++) {
         double normalized = (h[i] - bn_mean[i]) / MathSqrt(bn_var[i] + EPSILON);
         h[i] = bn_gamma[i] * normalized + bn_beta[i];
      }
   }

public:
   PredictionResult PredictMC(double &f[]) {
      double probs[30]; // 30 MC samples
      
      for(int mc=0; mc<30; mc++) {
         // Layer 1
         double h1[HIDDEN1];
         for(int j=0; j<HIDDEN1; j++) {
            h1[j] = b1[j];
            for(int i=0; i<MAX_FEATURES; i++)
               h1[j] += W1[i][j] * f[i];
         }
         
         // Batch Norm + Activation
         BatchNorm(h1, HIDDEN1);
         for(int j=0; j<HIDDEN1; j++)
            h1[j] = LeakyReLU(h1[j]);
         
         // Dropout Layer 1
         for(int j=0; j<HIDDEN1; j++)
            if(MathRand() % 100 < 50) h1[j] = 0; // 50% dropout
         
         // Layer 2
         double h2[HIDDEN2];
         for(int k=0; k<HIDDEN2; k++) {
            h2[k] = b2[k];
            for(int j=0; j<HIDDEN1; j++)
               h2[k] += W2[j][k] * h1[j];
            h2[k] = LeakyReLU(h2[k]);
         }
         
         // Output Layer
         double z = b3;
         for(int k=0; k<HIDDEN2; k++)
            z += W3[k] * h2[k];
         
         probs[mc] = 1.0 / (1.0 + MathExp(-z));
      }
      
      // Calcula média e variância
      double mean = 0, var = 0;
      for(int i=0; i<30; i++) mean += probs[i];
      mean /= 30;
      
      for(int i=0; i<30; i++) var += MathPow(probs[i] - mean, 2);
      var /= 30;
      
      PredictionResult res;
      res.probability = mean;
      res.uncertainty = MathSqrt(var);
      return res;
   }
};

