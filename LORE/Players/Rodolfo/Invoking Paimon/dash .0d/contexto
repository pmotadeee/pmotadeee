int OnInit() {
   Print("═══════════════════════════════════════════════════════════");
   Print("  PAIMON BLESS V18.0 QUANTUM - INITIALIZATION");
   Print("═══════════════════════════════════════════════════════════");
   
   if(!symbolInfo.Name(_Symbol)) return INIT_FAILED;
   symbolInfo.RefreshRates();
   
   trade.SetExpertMagicNumber(InpMagicNumber);
   trade.SetDeviationInPoints(50);
   trade.SetTypeFilling(ORDER_FILLING_FOK);
   
   // Initialize indicators
   h_rsi = iRSI(_Symbol, PERIOD_M5, InpRSIPeriod, PRICE_CLOSE);
   h_atr = iATR(_Symbol, PERIOD_M5, InpATRPeriod);
   h_adx = iADX(_Symbol, PERIOD_M5, InpADXPeriod);
   h_bb = iBands(_Symbol, PERIOD_M5, InpBBPeriod, 0, InpBBDeviation, PRICE_CLOSE);
   h_ema_fast = iMA(_Symbol, PERIOD_M5, 9, 0, MODE_EMA, PRICE_CLOSE);
   h_ema_slow = iMA(_Symbol, PERIOD_M5, 21, 0, MODE_EMA, PRICE_CLOSE);
   h_macd = iMACD(_Symbol, PERIOD_M5, 12, 26, 9, PRICE_CLOSE);
   h_stoch = iStochastic(_Symbol, PERIOD_M5, 14, 3, 3, MODE_SMA, STO_LOWHIGH);
   
   if(h_rsi == INVALID_HANDLE) {
      Print("❌ FAILED to create indicators");
      return INIT_FAILED;
   }
   
   // Load ML
   if(InpUseML) {
      g_mlp.Load();
      Print("✅ ML Model loaded: ", g_mlp.GetIterations(), " iterations");
   }
   
   g_equity_peak = AccountInfoDouble(ACCOUNT_EQUITY);
   g_last_reset = TimeCurrent();
   
   Print("✅ Quantum Engine initialized");
   Print("⚠️ LEGAL WARNING: Trading involves substantial risk of loss");
   Print("═══════════════════════════════════════════════════════════");
   
   return INIT_SUCCEEDED;
}

