//+------------------------------------------------------------------+
//| CLASSE: MULTI-LAYER PERCEPTRON (Deep Learning)                   |
//+------------------------------------------------------------------+
class CMultiLayerPerceptron {
private:
   // Architecture: 12 -> 24 -> 12 -> 1
   double W1[MAX_FEATURES][HIDDEN_NEURONS];
   double b1[HIDDEN_NEURONS];
   double W2[HIDDEN_NEURONS][HIDDEN_NEURONS/2];
   double b2[HIDDEN_NEURONS/2];
   double W3[HIDDEN_NEURONS/2];
   double b3;
   
   double momentum_W1[MAX_FEATURES][HIDDEN_NEURONS];
   double momentum_b1[HIDDEN_NEURONS];
   double momentum_W2[HIDDEN_NEURONS][HIDDEN_NEURONS/2];
   double momentum_b2[HIDDEN_NEURONS/2];
   double momentum_W3[HIDDEN_NEURONS/2];
   double momentum_b3;
   
   int iterations;
   
   double LeakyReLU(double x) const {
      return (x > 0) ? x : 0.01 * x;
   }
   
   double LeakyReLU_Deriv(double x) const {
      return (x > 0) ? 1.0 : 0.01;
   }
   
   double Sigmoid(double x) const {
      if(x < -20) return 0.0;
      if(x > 20) return 1.0;
      return 1.0 / (1.0 + MathExp(-x));
   }

public:
   CMultiLayerPerceptron() {
      // Xavier initialization
      double limit1 = MathSqrt(6.0 / (MAX_FEATURES + HIDDEN_NEURONS));
      for(int i=0; i<MAX_FEATURES; i++)
         for(int j=0; j<HIDDEN_NEURONS; j++)
            W1[i][j] = (MathRand()/32767.0 * 2.0 - 1.0) * limit1;
      
      double limit2 = MathSqrt(6.0 / (HIDDEN_NEURONS + HIDDEN_NEURONS/2));
      for(int i=0; i<HIDDEN_NEURONS; i++)
         for(int j=0; j<HIDDEN_NEURONS/2; j++)
            W2[i][j] = (MathRand()/32767.0 * 2.0 - 1.0) * limit2;
      
      double limit3 = MathSqrt(6.0 / (HIDDEN_NEURONS/2 + 1));
      for(int i=0; i<HIDDEN_NEURONS/2; i++)
         W3[i] = (MathRand()/32767.0 * 2.0 - 1.0) * limit3;
      
      ArrayInitialize(b1, 0.0);
      ArrayInitialize(b2, 0.0);
      b3 = 0.0;
      
      ArrayInitialize(momentum_b1, 0.0);
      ArrayInitialize(momentum_b2, 0.0);
      momentum_b3 = 0.0;
      
      iterations = 0;
   }
   
   PredictionResult PredictMC(const double &features[]) {
      double probs[50];
      
      for(int mc=0; mc<InpMCDropoutSamples; mc++) {
         // Re-seed
         MathSrand((int)(GetMicrosecondCount() + mc * 1000));
         
         // Layer 1
         double h1[HIDDEN_NEURONS];
         for(int j=0; j<HIDDEN_NEURONS; j++) {
            h1[j] = b1[j];
            for(int i=0; i<MAX_FEATURES; i++)
               h1[j] += W1[i][j] * features[i];
            h1[j] = LeakyReLU(h1[j]);
            
            // Dropout 50%
            if((MathRand() % 1000) < 500) h1[j] = 0;
            else h1[j] *= 2.0; // Inverted dropout
         }
         
         // Layer 2
         double h2[HIDDEN_NEURONS/2];
         for(int k=0; k<HIDDEN_NEURONS/2; k++) {
            h2[k] = b2[k];
            for(int j=0; j<HIDDEN_NEURONS; j++)
               h2[k] += W2[j][k] * h1[j];
            h2[k] = LeakyReLU(h2[k]);
         }
         
         // Output
         double z = b3;
         for(int k=0; k<HIDDEN_NEURONS/2; k++)
            z += W3[k] * h2[k];
         
         probs[mc] = Sigmoid(z);
      }
      
      // Statistics
      PredictionResult res;
      double sum = 0, sum_sq = 0;
      for(int i=0; i<InpMCDropoutSamples; i++) {
         sum += probs[i];
         sum_sq += probs[i] * probs[i];
      }
      
      res.probability = sum / InpMCDropoutSamples;
      double var = sum_sq/InpMCDropoutSamples - res.probability*res.probability;
      res.uncertainty = (var > 0) ? MathSqrt(var) : 0.0;
      res.sharpe_expected = 0.0; // TODO
      res.cvar_95 = 0.0; // TODO
      
      return res;
   }
   
   void Train(const double &features[], double target) {
      // Forward pass (sem dropout no treino)
      double h1[HIDDEN_NEURONS];
      for(int j=0; j<HIDDEN_NEURONS; j++) {
         h1[j] = b1[j];
         for(int i=0; i<MAX_FEATURES; i++)
            h1[j] += W1[i][j] * features[i];
         h1[j] = LeakyReLU(h1[j]);
      }
      
      double h2[HIDDEN_NEURONS/2];
      for(int k=0; k<HIDDEN_NEURONS/2; k++) {
         h2[k] = b2[k];
         for(int j=0; j<HIDDEN_NEURONS; j++)
            h2[k] += W2[j][k] * h1[j];
         h2[k] = LeakyReLU(h2[k]);
      }
      
      double z = b3;
      for(int k=0; k<HIDDEN_NEURONS/2; k++)
         z += W3[k] * h2[k];
      
      double pred = Sigmoid(z);
      
      // Backpropagation
      double error = target - pred;
      double grad_out = error * pred * (1.0 - pred);
      
      // Layer 3 gradients
      for(int k=0; k<HIDDEN_NEURONS/2; k++) {
         double grad_W3 = grad_out * h2[k];
         momentum_W3[k] = 0.9 * momentum_W3[k] + InpLearningRate * (grad_W3 - InpL2Lambda * W3[k]);
         W3[k] += momentum_W3[k];
      }
      momentum_b3 = 0.9 * momentum_b3 + InpLearningRate * grad_out;
      b3 += momentum_b3;
      
      iterations++;
   }
   
   int GetIterations() const { return iterations; }
   
   void Save() {
      int h = FileOpen(ML_FILE, FILE_WRITE|FILE_BIN);
      if(h != INVALID_HANDLE) {
         FileWriteInteger(h, iterations);
         // Save all weights (simplified)
         FileClose(h);
      }
   }
   
   void Load() {
      if(FileIsExist(ML_FILE)) {
         int h = FileOpen(ML_FILE, FILE_READ|FILE_BIN);
         if(h != INVALID_HANDLE) {
            iterations = FileReadInteger(h);
            // Load all weights (simplified)
            FileClose(h);
         }
      }
   }
};

