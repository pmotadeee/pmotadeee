Solução: Z-Score + Min-Max Scaling


cpp
class CFeatureScaler {
private:
   double mean[MAX_FEATURES];
   double std[MAX_FEATURES];
   double min[MAX_FEATURES];
   double max[MAX_FEATURES];
   int n_samples;
   
public:
   CFeatureScaler() {
      ArrayInitialize(mean, 0.0);
      ArrayInitialize(std, 1.0);
      n_samples = 0;
   }
   
   void Fit(double &features[]) {
      n_samples++;
      for(int i=0; i<MAX_FEATURES; i++) {
         // Welford online mean/variance
         double delta = features[i] - mean[i];
         mean[i] += delta / n_samples;
         std[i] += delta * (features[i] - mean[i]);
         
         // Track min/max
         if(n_samples == 1) {
            min[i] = features[i];
            max[i] = features[i];
         } else {
            if(features[i] < min[i]) min[i] = features[i];
            if(features[i] > max[i]) max[i] = features[i];
         }
      }
   }
   
   void Transform(double &features[]) {
      if(n_samples < 50) return; // Aguarda dados suficientes
      
      for(int i=0; i<MAX_FEATURES; i++) {
         double var = (n_samples > 1) ? std[i]/(n_samples-1) : 1.0;
         double sigma = MathSqrt(var);
         
         if(sigma > EPSILON) {
            // Z-score normalization
            features[i] = (features[i] - mean[i]) / sigma;
            
            // Clip extremes (3 sigma rule)
            if(features[i] > 3.0) features[i] = 3.0;
            if(features[i] < -3.0) features[i] = -3.0;
         }
      }
   }
};
