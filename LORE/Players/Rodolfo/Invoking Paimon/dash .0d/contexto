   if(GetCurrentDD() > InpMaxDrawdownPercent * 0.8) icon = "🔴";
   
   double adaptive_threshold = g_regime_detector.GetAdaptiveThreshold(InpMinProbability);
   
   string dash = "";
   dash += "╔════ PAIMON V18.0 QUANTUM ════╗\n";
   dash += "║ " + icon + " " + g_status + "\n";
   dash += "║ Regime: " + g_regime + "\n";
   dash += "║──────────────────────────────\n";
   dash += "║ Prob: " + DoubleToString(pred.probability*100,1) + "% ±" + DoubleToString(pred.uncertainty*100,1) + "%\n";
   dash += "║ Thresh: >" + DoubleToString(adaptive_threshold*100,0) + "% (B) <" + DoubleToString((1-adaptive_threshold)*100,0) + "% (S)\n";
