Problema:
• Threshold fixo não adapta ao regime de mercado
• Em mercados trendy, precisa de threshold mais alto
• Em mercados laterais, threshold pode ser mais permissivo
Solução: Threshold Adaptativo (Regime-Dependent)


cpp
class CRegimeDetector {
private:
   double returns[100];
   int head;
   
public:
   CRegimeDetector() { head = 0; ArrayInitialize(returns, 0); }
   
   void Update(double ret) {
      returns[head] = ret;
      head = (head + 1) % 100;
   }
   
   string GetRegime() {
      // Calcula autocorrelação lag-1
      double mean = 0;
      for(int i=0; i<100; i++) mean += returns[i];
      mean /= 100;
      
      double num = 0, den = 0;
      for(int i=0; i<99; i++) {
         num += (returns[i] - mean) * (returns[i+1] - mean);
         den += (returns[i] - mean) * (returns[i] - mean);
      }
      
      double acf1 = (den > EPSILON) ? num / den : 0.0;
      
      // Hurst exponent aproximado
      double hurst = 0.5 + 0.5 * acf1;
      
      if(hurst > 0.55) return "TRENDING";
      if(hurst < 0.45) return "MEAN_REVERTING";
      return "RANDOM_WALK";
   }
   
   double GetAdaptiveThreshold(double baseThreshold) {
      string regime = GetRegime();
      
      if(regime == "TRENDING") {
         // Trending: exige mais confiança
         return baseThreshold + 0.05; // 0.52 -> 0.57
      }
      else if(regime == "MEAN_REVERTING") {
         // Mean-revert: pode ser mais agressivo
         return baseThreshold - 0.03; // 0.52 -> 0.49
      }
      
      return baseThreshold; // Random walk
   }
};
