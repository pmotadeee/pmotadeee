void OnTick() {
   // Daily reset
   if(TimeCurrent() - g_last_reset > 86400) {
      g_daily_pnl = 0;
      g_last_reset = TimeCurrent();
   }
   
   // Drawdown check
   double dd = GetCurrentDD();
   if(dd > InpMaxDrawdownPercent) {
      g_status = "⛔ HALT: MAX DD";
      PredictionResult dummy;
      dummy.probability = 0.5;
      dummy.uncertainty = 0.0;
      UpdateDashboard(dummy, 0.0);
      return;
   }
   
   // Extract features
   QuantumFeatures raw_features = ExtractQuantumFeatures();
   
   // Fit scaler
   g_scaler.Fit(raw_features);
   
   // Transform features
   QuantumFeatures scaled_features = raw_features;
   g_scaler.Transform(scaled_features);
   
   // Convert to array
   double feat_array[MAX_FEATURES];
   for(int i=0; i<MAX_FEATURES; i++)
      feat_array[i] = scaled_features.Get(i);
   
   // Predictions
   PredictionResult mlp_pred = g_mlp.PredictMC(feat_array);
   double bayes_pred = g_bayes.Predict(feat_array);
   
   // Ensemble fusion (weighted by uncertainty)
   double w_mlp = 1.0 - mlp_pred.uncertainty;
   double w_bayes = mlp_pred.uncertainty;
   double final_prob = (mlp_pred.probability * w_mlp) + (bayes_pred * w_bayes);
   
   PredictionResult final_pred;
   final_pred.probability = final_prob;
   final_pred.uncertainty = mlp_pred.uncertainty;
   
   // Kelly fraction
   double kelly_f = g_kelly.GetOptimalFraction(dd);
   
   // Regime detection
   g_regime = g_regime_detector.GetRegime();
   
   // Logging
   LogHeartbeat(final_pred, kelly_f);
   UpdateDashboard(final_pred, kelly_f);
   
   // Decision logic
   bool signal = false;
   bool is_buy = false;
   
   double adaptive_threshold = g_regime_detector.GetAdaptiveThreshold(InpMinProbability);
   
   if(final_pred.uncertainty < InpMaxUncertainty && g_metrics.total_trades >= InpMinTrainingTrades) {
      if(final_prob >= adaptive_threshold) {
         // Buy signal
         double rsi = GetIndicator(h_rsi);
         if(rsi < 70) { // Not overbought
            signal = true;
            is_buy = true;
         }
      }
      else if(final_prob <= (1.0 - adaptive_threshold)) {
         // Sell signal
         double rsi = GetIndicator(h_rsi);
         if(rsi > 30) { // Not oversold
            signal = true;
            is_buy = false;
         }
      }
   }
   
   g_status = signal ? (is_buy ? "🟢 BUY SIGNAL" : "🔴 SELL SIGNAL") : "🟡 SCANNING";
   if(final_pred.uncertainty > InpMaxUncertainty) g_status = "🟠 HIGH UNCERTAINTY";
   if(g_metrics.total_trades < InpMinTrainingTrades) g_status = "❄️ COLD START";
   
   // Execution
   if(signal && TimeCurrent() - g_last_trade > InpMinBarsBetween * 300 && CountMagicPositions() < 2) {
      double equity = AccountInfoDouble(ACCOUNT_EQUITY);
      double risk_money = equity * kelly_f;
      
      double atr = GetIndicator(h_atr);
      double sl_dist = atr * 2.0;
      double tp_dist = sl_dist * 2.0; // R:R 1:2
      
      double sl_points = sl_dist / SymbolInfoDouble(_Symbol, SYMBOL_POINT);
      double tick_val = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
      
      double lot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
      if(sl_points > 0 && tick_val > 0) {
         lot = risk_money / (sl_points * tick_val);
      }
      
      double step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
      lot = MathFloor(lot/step) * step;
      lot = MathMax(lot, SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN));
      lot = MathMin(lot, SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX));
      
      double price = is_buy ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);
      double sl = is_buy ? price - sl_dist : price + sl_dist;
      double tp = is_buy ? price + tp_dist : price - tp_dist;
      
      string comment = "V18_Quantum";
      bool res = false;
      
      if(InpEnableLogs)
         PrintFormat(">>> EXECUTING %s: Lot=%.2f Price=%.5f SL=%.5f TP=%.5f Prob=%.1f%%",
                    is_buy ? "BUY" : "SELL", lot, price, sl, tp, final_prob*100);
      
      if(is_buy) res = trade.Buy(lot, _Symbol, price, sl, tp, comment);
      else res = trade.Sell(lot, _Symbol, price, sl, tp, comment);
      
      if(res) {
         g_last_trade = TimeCurrent();
         g_last_features = scaled_features;
         Print("✅ ORDER SUCCESS");
      } else {
         Print("❌ ORDER FAILED: ", trade.ResultRetcodeDescription());
      }
   }
}

