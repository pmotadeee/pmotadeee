//+------------------------------------------------------------------+
//| CLASSE: ROLLING STATISTICS (Welford Algorithm)                   |
//+------------------------------------------------------------------+
class CRollingStats {
private:
   double M1, M2, M3, M4;
   long n;
   
public:
   CRollingStats() { Reset(); }
   
   void Reset() {
      M1 = 0; M2 = 0; M3 = 0; M4 = 0; n = 0;
   }
   
   void Update(double x) {
      long n1 = n;
      n++;
      
      double delta = x - M1;
      double delta_n = delta / n;
      double delta_n2 = delta_n * delta_n;
      double term1 = delta * delta_n * n1;
      
      // Welford's algorithm para 4 momentos
      M4 += term1 * delta_n2 * (n*n - 3*n + 3) + 6*delta_n2*M2 - 4*delta_n*M3;
      M3 += term1 * delta_n * (n - 2) - 3*delta_n*M2;
      M2 += term1;
      M1 += delta_n;
   }
   
   double Mean() const { return M1; }
   
   double Variance() const { 
      return (n > 1) ? M2 / (n - 1) : 0.0; 
   }
   
   double StdDev() const { 
      return MathSqrt(Variance()); 
   }
   
   double Skewness() const {
      if(n < 3 || M2 <= EPSILON) return 0.0;
      return (MathSqrt(n) * M3) / MathPow(M2, 1.5);
   }
   
   double Kurtosis() const {
      if(n < 4 || M2 <= EPSILON) return 0.0;
      return (n * M4) / (M2 * M2) - 3.0; // Excess kurtosis
   }
   
   long Count() const { return n; }
};

//+------------------------------------------------------------------+
//| CLASSE: FEATURE SCALER (Z-Score + Min-Max)                       |
//+------------------------------------------------------------------+
class CFeatureScaler {
private:
   CRollingStats stats[MAX_FEATURES];
   double min_vals[MAX_FEATURES];
   double max_vals[MAX_FEATURES];
   bool initialized;
   
public:
   CFeatureScaler() {
      initialized = false;
      ArrayInitialize(min_vals, 1e10);
      ArrayInitialize(max_vals, -1e10);
   }
   
   void Fit(const QuantumFeatures &f) {
      for(int i=0; i<MAX_FEATURES; i++) {
         double val = f.Get(i);
         stats[i].Update(val);
         
         if(val < min_vals[i]) min_vals[i] = val;
         if(val > max_vals[i]) max_vals[i] = val;
      }
      
      if(stats[0].Count() >= 50) initialized = true;
   }
   
   void Transform(QuantumFeatures &f) {
      if(!initialized) return;
      
      for(int i=0; i<MAX_FEATURES; i++) {
         double val = f.Get(i);
         double mean = stats[i].Mean();
         double std = stats[i].StdDev();
         
         if(std > EPSILON) {
            // Z-score normalization
            val = (val - mean) / std;
            
            // Clip to [-3, 3] (3-sigma rule)
            if(val > 3.0) val = 3.0;
            if(val < -3.0) val = -3.0;
            
            f.Set(i, val);
         }
      }
   }
};

