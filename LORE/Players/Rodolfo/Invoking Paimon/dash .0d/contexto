//+------------------------------------------------------------------+
//| CLASSE: REGIME DETECTOR (HMM + Hurst Exponent)                   |
//+------------------------------------------------------------------+
class CRegimeDetector {
private:
   double returns[252]; // 1 year daily returns
   int head;
   bool buffer_full;
   
public:
   CRegimeDetector() {
      head = 0;
      buffer_full = false;
      ArrayInitialize(returns, 0.0);
   }
   
   void Update(double ret) {
      returns[head] = ret;
      head = (head + 1) % 252;
      if(head == 0) buffer_full = true;
   }
   
   double CalculateHurst() {
      if(!buffer_full) return 0.5;
      
      int n = 252;
      double mean = 0;
      for(int i=0; i<n; i++) mean += returns[i];
      mean /= n;
      
      // Desvio acumulado
      double Y[252];
      Y[0] = returns[0] - mean;
      for(int i=1; i<n; i++)
         Y[i] = Y[i-1] + (returns[i] - mean);
      
      // Range
      double R_min = Y[0], R_max = Y[0];
      for(int i=1; i<n; i++) {
         if(Y[i] < R_min) R_min = Y[i];
         if(Y[i] > R_max) R_max = Y[i];
      }
      double R = R_max - R_min;
      
      // Standard deviation
      double S = 0;
      for(int i=0; i<n; i++)
         S += MathPow(returns[i] - mean, 2);
      S = MathSqrt(S / n);
      
      if(S <= EPSILON) return 0.5;
      
      // Hurst = log(R/S) / log(n)
      double RS = R / S;
      if(RS <= 0) return 0.5;
      
      return MathLog(RS) / MathLog(n);
   }
   
   double CalculateAutocorrelation() {
      if(!buffer_full) return 0.0;
      
      double mean = 0;
      for(int i=0; i<252; i++) mean += returns[i];
      mean /= 252;
      
      double num = 0, den = 0;
      for(int i=0; i<251; i++) {
         num += (returns[i] - mean) * (returns[i+1] - mean);
         den += MathPow(returns[i] - mean, 2);
      }
      
      return (den > EPSILON) ? num / den : 0.0;
   }
   
   string GetRegime() {
      double hurst = CalculateHurst();
      double acf1 = CalculateAutocorrelation();
      
      // Trending: H > 0.55 e ACF > 0.1
      if(hurst > 0.55 && acf1 > 0.1) return "TRENDING";
      
      // Mean-reverting: H < 0.45 e ACF < -0.1
      if(hurst < 0.45 && acf1 < -0.1) return "MEAN_REVERT";
      
      // Random walk
      return "RANDOM_WALK";
   }
   
   double GetAdaptiveThreshold(double base_threshold) {
      string regime = GetRegime();
      
      if(regime == "TRENDING") {
         // Trending: exige mais confiança
         return base_threshold + 0.05;
      }
      else if(regime == "MEAN_REVERT") {
         // Mean-revert: pode ser mais agressivo
         return base_threshold - 0.03;
      }
      
      return base_threshold;
   }
};

