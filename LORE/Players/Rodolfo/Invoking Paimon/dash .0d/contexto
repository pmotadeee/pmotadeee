class CCorrelationMatrix {
private:
   #define MAX_SYMBOLS 10
   string symbols[MAX_SYMBOLS];
   double returns[MAX_SYMBOLS][252]; // 1 ano de retornos diários
   int head;
   
public:
   double GetCorrelation(string sym1, string sym2) {
      int idx1 = -1, idx2 = -1;
      for(int i=0; i<MAX_SYMBOLS; i++) {
         if(symbols[i] == sym1) idx1 = i;
         if(symbols[i] == sym2) idx2 = i;
      }
      
      if(idx1 < 0 || idx2 < 0) return 0.0;
      
      // Pearson correlation
      double sum1 = 0, sum2 = 0;
      for(int i=0; i<252; i++) {
         sum1 += returns[idx1][i];
         sum2 += returns[idx2][i];
      }
      double mean1 = sum1 / 252;
      double mean2 = sum2 / 252;
      
      double num = 0, den1 = 0, den2 = 0;
      for(int i=0; i<252; i++) {
         double d1 = returns[idx1][i] - mean1;
         double d2 = returns[idx2][i] - mean2;
         num += d1 * d2;
         den1 += d1 * d1;
         den2 += d2 * d2;
      }
      
      return (den1 * den2 > EPSILON) ? num / MathSqrt(den1 * den2) : 0.0;
   }
};

