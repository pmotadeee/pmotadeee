//+------------------------------------------------------------------+
//| CLASSE: BAYESIAN GAUSSIAN NAIVE BAYES (Corrected)                |
//+------------------------------------------------------------------+
class CBayesianGNB {
private:
   CRollingStats stats_win[MAX_FEATURES];
   CRollingStats stats_loss[MAX_FEATURES];
   double prior_win;
   double prior_loss;
   
public:
   CBayesianGNB() {
      prior_win = 1.0;
      prior_loss = 1.0;
   }
   
   void Update(const double &features[], bool is_win) {
      if(is_win) {
         prior_win++;
         for(int i=0; i<MAX_FEATURES; i++)
            stats_win[i].Update(features[i]);
      } else {
         prior_loss++;
         for(int i=0; i<MAX_FEATURES; i++)
            stats_loss[i].Update(features[i]);
      }
   }
   
   double Predict(const double &features[]) {
      double total = prior_win + prior_loss;
      double log_p_win = MathLog(prior_win / total);
      double log_p_loss = MathLog(prior_loss / total);
      
      for(int i=0; i<MAX_FEATURES; i++) {
         double mean_w = stats_win[i].Mean();
         double var_w = stats_win[i].Variance();
         if(var_w < 0.001) var_w = 0.001;
         
         double mean_l = stats_loss[i].Mean();
         double var_l = stats_loss[i].Variance();
         if(var_l < 0.001) var_l = 0.001;
         
         log_p_win += LogGaussian(features[i], mean_w, var_w);
         log_p_loss += LogGaussian(features[i], mean_l, var_l);
      }
      
      // Numerical stability
      double max_log = MathMax(log_p_win, log_p_loss);
      double exp_w = MathExp(log_p_win - max_log);
      double exp_l = MathExp(log_p_loss - max_log);
      
      return exp_w / (exp_w + exp_l);
   }

private:
   double LogGaussian(double x, double mu, double var) {
      return -0.5 * MathLog(2 * M_PI * var) - 0.5 * MathPow(x - mu, 2) / var;
   }
};

