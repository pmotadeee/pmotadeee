//+------------------------------------------------------------------+
//| CLASSE: KELLY CRITERION (Multivariado + Higher Moments)          |
//+------------------------------------------------------------------+
class CKellyEngine {
private:
   CRollingStats win_stats;
   CRollingStats loss_stats;
   double returns[252];
   int head;
   
public:
   CKellyEngine() {
      head = 0;
      ArrayInitialize(returns, 0.0);
   }
   
   void AddTrade(double pnl, double capital) {
      if(capital <= 0) return;
      
      double ret = pnl / capital;
      returns[head] = ret;
      head = (head + 1) % 252;
      
      if(pnl > 0) win_stats.Update(MathAbs(ret));
      else loss_stats.Update(MathAbs(ret));
   }
   
   double GetOptimalFraction(double current_dd) {
      if(win_stats.Count() + loss_stats.Count() < 20) {
         return 0.01; // Conservative start
      }
      
      double p = (double)win_stats.Count() / (win_stats.Count() + loss_stats.Count());
      double avg_win = win_stats.Mean();
      double avg_loss = loss_stats.Mean();
      
      if(avg_loss <= EPSILON) avg_loss = 0.01;
      
      double b = avg_win / avg_loss;
      double f_base = (p * b - (1-p)) / b;
      
      // Ajuste para momentos superiores (Jondeau & Rockinger, 2003)
      double skew = win_stats.Skewness();
      double kurt = win_stats.Kurtosis();
      
      double f_adj = f_base 
                     - (skew / 6.0) * f_base * f_base
                     - (kurt / 24.0) * f_base * f_base * f_base;
      
      // Fator de segurança
      f_adj *= InpKellyFraction;
      
      // Ajuste por drawdown (exponencial)
      if(current_dd > 0.05)
         f_adj *= MathExp(-current_dd * 5.0);
      
      return MathMax(0.001, MathMin(f_adj, InpMaxRiskPercent));
   }
   
   string GetStats() {
      return StringFormat("W:%d L:%d Skew:%.2f Kurt:%.2f",
                         (int)win_stats.Count(),
                         (int)loss_stats.Count(),
                         win_stats.Skewness(),
                         win_stats.Kurtosis());
   }
};

